{
  "permissions": {
    "defaultMode": "plan",
    "allow": [
      "Bash(npm test *)",
      "Bash(uv run pytest *)"
    ],
    "deny": [
      "Read(./api/.env)",
      "Edit(./infra/*.tfvars)",
      "Bash(git push *)",
      "Bash(terraform apply *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}\"/.claude/hooks/paso-actual.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}\"/.claude/hooks/vigia.py impedir"
          }
        ]
      }
    ]
  }
}
