{
  "permissions": {
    "defaultMode": "default",
    "allow": ["Bash(npm test *)", "Bash(uv run pytest *)"],
    "deny": [
      "Read(./api/.env)",
      "Edit(./infra/*.tfvars)",
      "Bash(git push *)",
      "Bash(terraform apply *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          { "type": "command", "command": "\"${CLAUDE_PROJECT_DIR}\"/.claude/hooks/paso-actual.sh" }
        ]
      }
    ]
  }
}
